# Railway の Variables に入れる（リポジトリには入れない）
LASK_PASSCODE=   # 合言葉（必須）。未設定だと何も配らない
LASK_SECRET=     # Cookie 署名鍵（任意）。変えると全端末で合言葉の入れ直し
DATABASE_URL=    # Railway Postgres（${{Postgres.DATABASE_URL}} で参照）。無ければメモリ動作
NOTION_TOKEN=    # 母艦への転記に使う Notion integration token（秋好OS と同じで可）。無ければ転記は待機
MOTHERSHIP_DB_ID=d7a9c4a9b3964b8198b272b9f83b88b4   # 📦母艦（全入力の原本）
